{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Institutional Trading System",
  "version": "1.0.0",
  "identifier": "com.its.trading",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Institutional Trading System",
        "width": 1024,
        "height": 600,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/app-icon.png"
    ]
  }
}