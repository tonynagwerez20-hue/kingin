{
  "name": "kingin-institutional-trading",
  "version": "1.0.0",
  "description": "Institutional Trading System Native Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:api": "python kingin_api.py",
    "dev:vite": "cd kingin-vite && npm run dev",
    "dev:electron": "wait-on http://127.0.0.1:5173 && electron .",
    "build": "cd kingin-vite && npm run build",
    "electron:build": "npm run build && electron-builder",
    "test": "pytest Engine/tests"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.kingin.trading",
    "productName": "KingIn Trading System",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*",
      "kingin-vite/dist/**/*",
      "kingin_api.py",
      "Engine/**/*",
      "utils/**/*",
      "config/**/*",
      "data/**/*",
      "models/**/*",
      "storage/**/*",
      "requirements.txt",
      "requirements_lite.txt"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "its_icon.ico",
      "uninstallerIcon": "its_icon.ico"
    }
  }
}
